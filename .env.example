# Invest + — copie este arquivo para .env.local e preencha. Nunca versione o .env.local.

# Postgres: o mesmo servidor do Capital + (deploy/postgres do repositório Capital), com um banco próprio.
#   Produção, no Docker do Pi:  postgres://invest:<INVEST_DB_PASSWORD>@capital-postgres:5432/invest
#   Desenvolvimento no PC:      postgres://invest_dev:<INVEST_DEV_DB_PASSWORD>@100.x.y.z:5432/invest_dev
DATABASE_URL=

# Login (Better Auth). Segredo: `openssl rand -base64 32` — um por ambiente; trocar desloga todo mundo.
BETTER_AUTH_SECRET=
# URL pública do app; os links dos e-mails apontam para ela. Em desenvolvimento: http://localhost:3001
BETTER_AUTH_URL=

# E-mails de confirmação de conta e de redefinição de senha. Gmail: SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=465, SMTP_USER=seu Gmail e SMTP_PASS=uma "senha de app" (exige verificação em duas
# etapas: myaccount.google.com/apppasswords). Sem SMTP_HOST, os e-mails só aparecem no log do servidor.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Remetente (opcional). Padrão: "Invest + <SMTP_USER>".
MAIL_FROM=

# Só para deploy atrás de proxy/túnel (Cloudflare, Tailscale, nginx). Hostnames separados por
# vírgula, sem "https://". Sem isso o login (Server Action) pode ser recusado pela proteção CSRF
# do Next. Ex.: invest.rincon.dev.br
APP_ALLOWED_ORIGINS=

# Administrador do servidor (opcional). Não libera nenhum recurso: todos os módulos são de todos os
# usuários. Só essa conta vê detalhes de configuração, na Administração.
OWNER_EMAIL=

# Conta de teste do primeiro acesso (opcional, para desenvolvimento). Entrar com ela cria a conta
# (já confirmada) e apaga os dados dela a cada login, então ela sempre abre como uma conta nova.
# Só aceita e-mail terminado em .test (domínio reservado, nenhuma caixa real) e nunca o OWNER_EMAIL.
TEST_ACCOUNT_EMAIL=
TEST_ACCOUNT_PASSWORD=

# Conta modelo da Início (opcional). Entrar com ela cria a conta (já confirmada); o que você
# arrumar na Início dela é a Início de toda conta nova e o "Voltar ao padrão". Sem ela, vale a
# Início do OWNER_EMAIL. Nunca o OWNER_EMAIL nem a conta de teste.
HOME_TEMPLATE_EMAIL=
HOME_TEMPLATE_PASSWORD=


# Notificações (Web Push). Gere um par de chaves por ambiente (dev e Pi) com:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Trocar as chaves invalida as inscrições: cada aparelho precisa ativar as notificações de novo.
# VAPID_SUBJECT é um contato para os serviços de push (https://... ou mailto:...).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Cifra os segredos guardados no banco (AES-256-GCM): a chave da Pluggy de cada pessoa no Open
# Finance. Uma por ambiente; trocar exige salvar a chave da Pluggy de novo. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Open Finance (Meu Pluggy): o servidor não tem chave da Pluggy, cada pessoa usa a dela. Para onde a
# Pluggy devolve a pessoa depois de autorizar um banco; padrão <BETTER_AUTH_URL>/bancos. Precisa ser
# https e nunca localhost: no desenvolvimento, aponte para o endereço https do app publicado e volte
# à aba do localhost depois de autorizar.
PLUGGY_REDIRECT_URI=

# O serviço de cotações do Pi (lib/server/quoteService.ts): o Capital + pergunta aqui o preço da Reserva
# investida em vez de ir sozinho à B3 e ao Yahoo. O mesmo segredo vai no .env.local do Capital +
# (QUOTES_SERVICE_TOKEN), que chama http://invest:3000/api/internal/quotes pela rede Docker. Pelo
# túnel (de fora) o endereço nunca responde. Sem ele, o serviço fica desligado. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
QUOTES_SERVICE_TOKEN=

# Agenda em segundo plano (leitura das corretoras), dentro do próprio servidor. SCHEDULER=off desliga
# (útil se você rodar um segundo servidor apontando para o mesmo banco).
SCHEDULER=

# --- Proteção do servidor (todas opcionais; os valores abaixo são os padrões) ---
# Guarda de carga (lib/server/loadGuard.ts). A média de requisições por segundo (últimos 5 s)
# a partir da qual o dono (OWNER_EMAIL) recebe um aviso, e a partir da qual o servidor pausa:
# por LOAD_SHED_SECONDS toda requisição recebe "volte em instantes" (a pausa se estende enquanto
# o pico continuar). Um único IP que passar de LOAD_IP_PER_10S em 10 segundos ou de LOAD_IP_PER_MINUTE
# por minuto é bloqueado sozinho — assim um IP só nunca consegue pausar o servidor para todos.
LOAD_ALERT_RPS=20
LOAD_SHED_RPS=50
LOAD_SHED_SECONDS=60
LOAD_IP_PER_MINUTE=600
LOAD_IP_PER_10S=100
# Temperatura da placa (°C, a zona térmica mais quente): aviso ao dono e pausa do servidor.
TEMP_ALERT_C=75
TEMP_SHED_C=85
# Teto de e-mails (confirmação e redefinição de senha) enviados pelo SMTP, para ninguém gastar a
# cota do seu Gmail criando contas para endereços de outras pessoas.
MAIL_MAX_PER_HOUR=30
MAIL_MAX_PER_DAY=200
# Cabeçalho com o IP real do visitante, posto pelo proxy (padrão: cf-connecting-ip, da Cloudflare).
# Só vale porque a porta do app fica presa a 127.0.0.1 (docker-compose.yml): ninguém fala direto
# com ele para forjar o cabeçalho.
TRUSTED_IP_HEADER=
# Endereço onde o container publica a porta 3001 (padrão 127.0.0.1: só o próprio Pi). Mude só se o
# cloudflared alcança o app por outro caminho (ex.: 172.17.0.1, o gateway da rede Docker).
INVEST_BIND=

# Só desenvolvimento: aparelhos que testam o `npm run dev` pela rede/VPN (IPs ou hosts, por vírgula).
DEV_ALLOWED_ORIGINS=
